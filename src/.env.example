# =============================================================================
# Переменные окружения
# =============================================================================
#
# Скопировать в .env и заполнить. Имена переменных провайдеров должны
# совпадать с providers[*].key_env из config/catalog.php.
#
# ВАЖНО: .env кладётся ВЫШЕ веб-корня, рядом с ним, а не внутри.
# Внутри его можно скачать по прямой ссылке вместе со всеми ключами.
#
#   <домашний каталог>/
#     ├── example_private/
#     │     ├── .env         ← здесь, chmod 600
#     │     ├── lib/
#     │     ├── config/
#     │     └── data/        ← chmod 700, балансы и хеши ключей
#     └── example.com/       ← веб-корень
#
# Базы данных нет: состояние хранится в файлах (см. lib/store.php и
# .kiro/steering/file-storage.md).
# =============================================================================

# --- Каталог данных ----------------------------------------------------------
# Обязательно. Должен быть вне веб-корня и доступен на запись.
DATA_DIR=/path/to/example_private/data

# --- Провайдеры --------------------------------------------------------------
# Ключи провайдеров. Пустой ключ означает, что модели этого провайдера
# не обслуживаются: шлюз ответит 503, а не упадёт.
PRIMARY_KEY=
FREETIER_KEY=
SPARE_KEY=

# --- Касса -------------------------------------------------------------------
# Без этих значений пакеты показываются, но кнопка оплаты неактивна.
# Это осознанное поведение, а не обрыв.
PAYMENT_SHOP_ID=
PAYMENT_SECRET=
PAYMENT_EXTRA_KEY=

# --- Почта (одноразовые коды входа) ------------------------------------------
# Пароля в системе нет: нет пароля — нет его утечки и повторного
# использования чужого пароля с другого сайта.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# --- Сайт --------------------------------------------------------------------
SITE_URL=https://example.com
SITE_NAME=Example
